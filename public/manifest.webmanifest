{
  "id": "./",
  "name": "SeatShop — Ventes Seatiks",
  "short_name": "SeatShop",
  "description": "Votre administration de vente de billets, façon Shopify. Ventes, inventaire et alertes en temps réel.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f4f4f5",
  "theme_color": "#0b2b23",
  "categories": ["business", "shopping", "productivity"],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-1024.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Ventes",
      "short_name": "Ventes",
      "description": "Voir les dernières ventes",
      "url": "./#/sales",
      "icons": [{ "src": "icons/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Inventaire",
      "short_name": "Inventaire",
      "description": "Voir les annonces en ligne",
      "url": "./#/listings",
      "icons": [{ "src": "icons/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Alertes",
      "short_name": "Alertes",
      "description": "Voir les alertes de vente",
      "url": "./#/alerts",
      "icons": [{ "src": "icons/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ]
}
